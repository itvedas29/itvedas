# Copy this file to .env and fill in real values.
# Never commit the real .env file (it is already in .gitignore).

# ── Content generation (scripts/brain.py, scripts/news_agent_v2.py) ──
ANTHROPIC_API_KEY=
GA4_ID=G-XXXXXXXXXX

# ── Email notifications (optional) ───────────────────────────────────
NOTIFY_EMAIL=
SMTP_FROM=
SMTP_PASS=

# ── GA4 Data API (itvedas-brain/analytics-agent.py) ───────────────────
GA4_PROPERTY_ID=
GA4_ACCESS_TOKEN=
GA4_ACCESS_TOKEN_FILE=

# ── Search Console API (itvedas-brain/search-console-agent.py) ────────
GSC_SITE_URL=
GSC_ACCESS_TOKEN=
GSC_ACCESS_TOKEN_FILE=

# ── GitHub Agent (itvedas-brain/github-agent.py --create-issues) ──────
GITHUB_TOKEN=

# ── Runtime ─────────────────────────────────────────────────────────
ITVEDAS_ENV=production
LOG_LEVEL=INFO
