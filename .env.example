# Copy this file to .env and fill in real values.
# Never commit the real .env file (it is already in .gitignore).

# ── AI Content Generation (Google Gemini 2.5 Flash) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Analytics & Verification ──
GA4_ID=G-D98BFZSJYP

# ── Optional Notifications ──
NOTIFY_EMAIL=
SMTP_FROM=
SMTP_PASS=

# ── Publishing review gate ──
# 1 (default): drafts that fail review, or whose review call fails, are not published.
# 0: legacy behaviour - publish regardless.
REVIEW_STRICT=1
