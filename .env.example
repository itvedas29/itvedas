# Copy this file to .env and fill in real values.
# Never commit the real .env file (it is already in .gitignore).

# ── AI Content Generation (Claude API) ──
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ── Analytics & Verification ──
GA4_ID=G-D98BFZSJYP

# ── Growth agent (docs/GROWTH-AGENT.md) ──
# Service-account key file contents (raw JSON or base64). Read-only access.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Numeric GA4 property id (Admin > Property details), not the G- measurement id.
GA4_PROPERTY_ID=
# 1 = analyse and report only, change nothing.
GROWTH_DRY_RUN=1

# ── Optional Notifications ──
NOTIFY_EMAIL=
SMTP_FROM=
SMTP_PASS=

# ── Publishing review gate ──
# 1 (default): drafts that fail review, or whose review call fails, are not published.
# 0: legacy behaviour - publish regardless.
REVIEW_STRICT=1
