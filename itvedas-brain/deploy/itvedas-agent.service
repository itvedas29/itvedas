[Unit]
Description=ITVedas AI Agent
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/itvedas/itvedas-brain
EnvironmentFile=/root/itvedas/itvedas-brain/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/itvedas/itvedas-brain/venv/bin/python3 -u agent.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
