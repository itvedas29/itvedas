{
  "name": "itvedas-knowledge-library",
  "version": "2.0.0",
  "description": "ITVedas - Professional vendor-neutral IT Knowledge Base",
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run generate:sitemap && npm run generate:search-index",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "generate:search-index": "node scripts/generate-search-index.js",
    "validate": "npm run type-check && npm run lint && npm run format:check"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@mdx-js/mdx": "^3.0.0",
    "@mdx-js/react": "^3.0.0",
    "@next/mdx": "^15.0.0",
    "next-mdx-remote": "^5.0.0",
    "gray-matter": "^4.0.3",
    "rss": "^1.2.2",
    "sitemapist": "^1.0.0",
    "fuse.js": "^7.0.0",
    "clsx": "^2.1.0",
    "tailwindcss": "^3.4.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.3.3",
    "eslint": "^8.55.0",
    "eslint-config-next": "^15.0.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.4.1",
    "@tailwindcss/typography": "^0.5.10",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/container-queries": "^0.1.1",
    "jest": "^29.7.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.1.5",
    "ts-jest": "^29.1.1"
  },
  "engines": {
    "node": ">=18.17.0"
  }
