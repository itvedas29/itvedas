diff --git a/css/site-nav.css b/css/site-nav.css
new file mode 100644
index 000000000..20ab9f702
--- /dev/null
+++ b/css/site-nav.css
@@ -0,0 +1,171 @@
+/* ITVedas site navigation. Shared by every page; markup lives in partials/site-nav.html.
+   Every selector is scoped under .site-header so older page styles (for example a
+   bare `nav { ... }` rule) cannot change how the menu looks. */
+
+.site-header {
+  --sn-ink: #182238;
+  --sn-muted: #5B6B84;
+  --sn-navy: #0B2750;
+  --sn-orange: #FF7A00;
+  --sn-orange-dark: #B35500;
+  --sn-line: #DCE3EF;
+  --sn-soft: #F3F6FB;
+  --sn-h: 64px;
+  position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
+  height: var(--sn-h);
+  background: rgba(255, 255, 255, 0.96);
+  border-bottom: 1px solid var(--sn-line);
+  font-family: 'Lexend', 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
+  font-size: 15px; line-height: 1.4; color: var(--sn-ink);
+  text-align: left; letter-spacing: normal; text-transform: none;
+  box-sizing: border-box;
+}
+/* Pages whose old bar sat in the normal flow (or had none) get a spacer, so content
+   starts below the fixed bar exactly as before. The bar itself is always fixed and
+   full width, whatever padding the page puts on <body>. */
+.sn-spacer { display: none; }
+.site-header[data-mode="sticky"] + .sn-spacer { display: block; height: 64px; }
+.site-header *, .site-header *::before, .site-header *::after { box-sizing: border-box; }
+@supports (backdrop-filter: blur(1px)) { .site-header { background: rgba(255, 255, 255, 0.88); backdrop-filter: blur(16px); } }
+
+/* Reset anything a page's own `nav`, `ul`, `a` or `button` rules might add. */
+.site-header .sn-nav {
+  all: unset; box-sizing: border-box;
+  display: flex; align-items: center; gap: 1rem;
+  max-width: 1240px; height: 100%; margin: 0 auto; padding: 0 1.25rem;
+}
+.site-header ul { list-style: none; margin: 0; padding: 0; }
+.site-header li { margin: 0; padding: 0; }
+.site-header li::before, .site-header li::marker { content: none; }
+.site-header a { text-decoration: none; color: inherit; background: none; border: 0; }
+.site-header button {
+  font: inherit; color: inherit; background: none; border: 0; margin: 0; padding: 0;
+  cursor: pointer; box-shadow: none; text-transform: none; letter-spacing: normal; min-height: 0; width: auto;
+}
+.site-header svg { display: inline-block; }
+.site-header :focus-visible { outline: 2px solid var(--sn-orange); outline-offset: 2px; border-radius: 6px; }
+
+.site-header .sn-skip {
+  position: absolute; left: 1rem; top: -100px; z-index: 2;
+  background: var(--sn-navy); color: #fff; padding: 0.5rem 0.9rem; border-radius: 6px;
+}
+.site-header .sn-skip:focus { top: 0.6rem; }
+.site-header .sn-vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+
+/* Logo */
+.site-header .sn-logo { display: inline-flex; align-items: center; gap: 0.4rem; flex: none; font-weight: 700; font-size: 1.3rem; letter-spacing: -0.02em; color: var(--sn-ink); }
+.site-header .sn-mark { width: 1.15em; height: 1.15em; }
+.site-header .sn-word span { color: #FF6B35; }
+
+/* Desktop menu */
+.site-header .sn-menu { display: flex; align-items: center; gap: 1rem; flex: 1; min-width: 0; }
+.site-header .sn-tops { display: flex; align-items: center; gap: 0.1rem; margin: 0 auto; }
+.site-header .sn-top { position: relative; }
+.site-header .sn-btn {
+  display: inline-flex; align-items: center; gap: 0.3rem;
+  padding: 0.5rem 0.75rem; border-radius: 8px; font-size: 0.93rem; font-weight: 500; color: #3A4760;
+}
+.site-header .sn-btn:hover, .site-header .sn-btn[aria-expanded="true"] { background: var(--sn-soft); color: var(--sn-ink); }
+.site-header .sn-top.is-current > .sn-btn { color: var(--sn-navy); box-shadow: inset 0 -2px 0 var(--sn-orange); border-radius: 8px 8px 0 0; }
+.site-header .sn-caret { width: 12px; height: 12px; transition: transform 0.15s; }
+.site-header .sn-btn[aria-expanded="true"] .sn-caret { transform: rotate(180deg); }
+
+.site-header .sn-panel {
+  display: none; position: absolute; top: calc(100% + 10px); left: 50%; transform: translateX(-50%);
+  width: 340px; padding: 0.6rem; background: #fff; border: 1px solid var(--sn-line); border-radius: 12px;
+  box-shadow: 0 18px 40px rgba(11, 39, 80, 0.14);
+}
+.site-header .sn-btn[aria-expanded="true"] + .sn-panel { display: block; }
+.site-header .sn-panel.sn-wide { width: min(900px, calc(100vw - 2rem)); left: 0; transform: none; padding: 1rem; }
+.site-header .sn-top:first-child .sn-panel.sn-wide { left: -1rem; }
+
+.site-header .sn-item, .site-header .sn-start { display: grid; gap: 0.1rem; padding: 0.55rem 0.7rem; border-radius: 8px; }
+.site-header .sn-item:hover, .site-header .sn-start:hover { background: var(--sn-soft); }
+.site-header .sn-item[aria-current="page"] { background: #FFF4EA; }
+.site-header .sn-t { font-weight: 600; font-size: 0.94rem; color: var(--sn-ink); }
+.site-header .sn-d { font-family: 'Inter', system-ui, sans-serif; font-weight: 400; font-size: 0.82rem; color: var(--sn-muted); line-height: 1.35; }
+.site-header .sn-item:hover .sn-t, .site-header .sn-start:hover .sn-t { color: var(--sn-orange-dark); }
+
+.site-header .sn-panel-head { margin-bottom: 0.6rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--sn-line); }
+.site-header .sn-start { background: #FFF4EA; }
+.site-header .sn-start .sn-t { color: var(--sn-navy); }
+.site-header .sn-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.4rem 0.8rem; }
+.site-header .sn-gt { margin: 0.2rem 0.7rem 0.3rem; font-size: 0.8rem; font-weight: 600; color: var(--sn-navy); }
+
+/* Right side */
+.site-header .sn-actions { display: flex; align-items: center; gap: 0.6rem; flex: none; }
+.site-header .sn-search-btn {
+  display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.45rem 0.8rem;
+  border: 1px solid var(--sn-line); border-radius: 999px; font-size: 0.88rem; color: #3A4760; background: #fff;
+}
+.site-header .sn-search-btn:hover { border-color: #B8C4D8; color: var(--sn-ink); }
+.site-header .sn-search-btn svg { width: 16px; height: 16px; }
+.site-header .sn-cta {
+  display: inline-flex; align-items: center; padding: 0.55rem 1rem; border-radius: 8px;
+  background: var(--sn-orange); color: #fff; font-weight: 600; font-size: 0.9rem;
+}
+.site-header .sn-cta:hover { background: #E06900; color: #fff; }
+
+/* Search panel */
+.site-header .sn-search {
+  position: absolute; top: calc(100% + 10px); left: 50%; transform: translateX(-50%);
+  width: min(620px, calc(100vw - 2rem)); background: #fff; border: 1px solid var(--sn-line);
+  border-radius: 12px; box-shadow: 0 18px 40px rgba(11, 39, 80, 0.16); padding: 0.75rem;
+}
+.site-header .sn-search[hidden] { display: none; }
+.site-header .sn-search-form { display: flex; gap: 0.5rem; }
+.site-header .sn-search-form input {
+  flex: 1; min-width: 0; font: inherit; font-family: 'Inter', system-ui, sans-serif; font-size: 1rem;
+  padding: 0.65rem 0.8rem; border: 1px solid var(--sn-line); border-radius: 8px; background: var(--sn-soft); color: var(--sn-ink);
+  margin: 0; width: auto; box-shadow: none; height: auto;
+}
+.site-header .sn-search-close { padding: 0 0.8rem; border-radius: 8px; color: var(--sn-muted); font-size: 0.88rem; }
+.site-header .sn-search-close:hover { background: var(--sn-soft); color: var(--sn-ink); }
+.site-header .sn-results { margin-top: 0.4rem; max-height: min(60vh, 440px); overflow-y: auto; }
+.site-header .sn-results:empty { display: none; }
+.site-header .sn-results a { display: grid; gap: 0.1rem; padding: 0.55rem 0.7rem; border-radius: 8px; }
+.site-header .sn-results a:hover, .site-header .sn-results a.is-active { background: var(--sn-soft); }
+.site-header .sn-results .sn-empty { padding: 0.7rem; color: var(--sn-muted); font-size: 0.9rem; }
+
+/* Burger (small screens) */
+.site-header .sn-burger { display: none; align-items: center; gap: 0.5rem; margin-left: auto; padding: 0.5rem 0.75rem; border-radius: 8px; font-weight: 600; font-size: 0.92rem; }
+.site-header .sn-burger:hover { background: var(--sn-soft); }
+.site-header .sn-burger-lines, .site-header .sn-burger-lines::before, .site-header .sn-burger-lines::after {
+  display: block; width: 18px; height: 2px; background: currentColor; border-radius: 2px; position: relative; content: '';
+}
+.site-header .sn-burger-lines::before { position: absolute; top: -6px; }
+.site-header .sn-burger-lines::after { position: absolute; top: 6px; }
+.site-header.is-open .sn-burger-lines { background: transparent; }
+.site-header.is-open .sn-burger-lines::before { top: 0; transform: rotate(45deg); }
+.site-header.is-open .sn-burger-lines::after { top: 0; transform: rotate(-45deg); }
+
+@media (max-width: 1080px) {
+  /* backdrop-filter would trap the fixed full-screen menu inside the 64px bar */
+  .site-header { backdrop-filter: none; background: #fff; }
+  .site-header .sn-burger { display: inline-flex; }
+  .site-header .sn-menu {
+    display: none; position: fixed; top: var(--sn-h); left: 0; right: 0; bottom: 0;
+    flex-direction: column; align-items: stretch; gap: 0; overflow-y: auto;
+    background: #fff; border-top: 1px solid var(--sn-line); padding: 0.5rem 1rem 2rem;
+  }
+  .site-header.is-open .sn-menu { display: flex; }
+  .site-header .sn-tops { flex-direction: column; align-items: stretch; margin: 0; gap: 0; }
+  .site-header .sn-top { border-bottom: 1px solid var(--sn-line); }
+  .site-header .sn-btn { width: 100%; justify-content: space-between; padding: 0.95rem 0.25rem; font-size: 1.02rem; border-radius: 0; }
+  .site-header .sn-btn:hover, .site-header .sn-btn[aria-expanded="true"] { background: none; }
+  .site-header .sn-top.is-current > .sn-btn { box-shadow: none; }
+  .site-header .sn-top.is-current > .sn-btn::after { content: 'You are here'; margin-left: auto; margin-right: 0.5rem; font-size: 0.75rem; font-weight: 500; color: var(--sn-orange-dark); }
+  .site-header .sn-panel, .site-header .sn-panel.sn-wide {
+    position: static; transform: none; width: auto; box-shadow: none; border: 0; border-radius: 0; padding: 0 0 0.75rem;
+  }
+  .site-header .sn-grid { grid-template-columns: 1fr; }
+  .site-header .sn-actions { flex-direction: column; align-items: stretch; margin-top: 1rem; gap: 0.6rem; }
+  .site-header .sn-search-btn, .site-header .sn-cta { justify-content: center; padding: 0.8rem 1rem; font-size: 1rem; border-radius: 8px; }
+  .site-header .sn-search { position: fixed; top: calc(var(--sn-h) + 0.5rem); }
+}
+@media (min-width: 1081px) and (max-width: 1200px) {
+  .site-header .sn-search-btn span { display: none; }
+  .site-header .sn-btn { padding: 0.5rem 0.55rem; }
+}
+@media (prefers-reduced-motion: reduce) { .site-header .sn-caret { transition: none; } }
+@media print { .site-header { display: none; } }
diff --git a/js/site-nav.js b/js/site-nav.js
new file mode 100644
index 000000000..f2834f92c
--- /dev/null
+++ b/js/site-nav.js
@@ -0,0 +1,203 @@
+/* ITVedas site navigation behaviour (menus, mobile menu, search, current section).
+   Markup: partials/site-nav.html. No inline handlers. */
+(function () {
+  'use strict';
+
+  // GA4 event layer (was loaded by the old nav-mega.js). No-op when gtag is absent.
+  if (!document.querySelector('script[src="/js/itvedas-events.js"]')) {
+    var ev = document.createElement('script');
+    ev.src = '/js/itvedas-events.js';
+    ev.async = true;
+    document.head.appendChild(ev);
+  }
+
+  var SECTIONS = {
+    learn: ['/articles/', '/chapters'],
+    news: ['/news', '/security-news'],
+    software: ['/software/', '/ai-tools'],
+    tools: ['/tools/', '/cve-listing', '/cve/', '/cve-detail'],
+    careers: ['/career-paths', '/career-navigator', '/quiz'],
+    help: ['/problems-solutions', '/faq', '/about', '/services', '/contact', '/author']
+  };
+
+  var QUICK = [
+    ['Networking', '/articles/networking/', 'How devices connect and share data', 'wifi internet router ip dns vpn'],
+    ['Hardware', '/articles/hardware/', 'What is inside a computer', 'cpu ram ssd laptop pc memory'],
+    ['Linux', '/articles/linux/', 'The system most servers run on', 'terminal ubuntu bash command'],
+    ['Cloud', '/articles/cloud/', 'Renting computers and storage online', 'aws azure google storage'],
+    ['Security', '/articles/security/', 'Protecting people and systems', 'password hacking virus malware phishing firewall'],
+    ['Compliance', '/articles/compliance/', 'Rules for handling data', 'gdpr hipaa iso privacy'],
+    ['APIs', '/articles/api/', 'How apps talk to each other', 'rest json integration'],
+    ['DevOps', '/articles/devops/', 'How software is built and released', 'docker kubernetes pipeline'],
+    ['Databases', '/articles/databases/', 'Where apps keep their information', 'sql data mysql'],
+    ['AI models', '/articles/ai-models/', 'How AI tools work', 'chatgpt ai machine learning llm'],
+    ['Software specs', '/software/', 'Requirements, prices and reviews', 'endpoint central manageengine software'],
+    ['Free IT tools', '/tools/', 'Calculators and lookups', 'password generator dns whois ip subnet'],
+    ['Security flaw lookup', '/cve-listing', 'Search known vulnerabilities', 'cve vulnerability exploit patch'],
+    ['Problems and fixes', '/problems-solutions', 'Fixes for common issues', 'slow printer error fix help'],
+    ['Career paths', '/career-paths', 'What each IT job involves', 'job career salary certification'],
+    ['Latest IT news', '/news', 'What happened this week', 'news update']
+  ];
+
+  function ready(fn) { if (document.readyState !== 'loading') fn(); else document.addEventListener('DOMContentLoaded', fn); }
+
+  ready(function () {
+    var header = document.querySelector('.site-header');
+    if (!header) return;
+    var path = location.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
+
+    // Skip link target: first <main>, else the element right after the header.
+    if (!document.getElementById('main-content')) {
+      var target = document.querySelector('main') || header.nextElementSibling;
+      if (target) { if (!target.id) target.id = 'main-content'; else header.querySelector('.sn-skip').setAttribute('href', '#' + target.id); }
+    }
+
+    // Mark the current section and page.
+    Object.keys(SECTIONS).forEach(function (key) {
+      if (SECTIONS[key].some(function (p) { return path === p.replace(/\/$/, '') || path.indexOf(p) === 0; })) {
+        var li = header.querySelector('.sn-top[data-section="' + key + '"]');
+        if (li) li.classList.add('is-current');
+      }
+    });
+    header.querySelectorAll('.sn-item, .sn-start').forEach(function (a) {
+      var h = a.getAttribute('href').replace(/\.html$/, '');
+      if (h === path || h.replace(/\/$/, '') === path.replace(/\/$/, '')) a.setAttribute('aria-current', 'page');
+    });
+
+    var buttons = header.querySelectorAll('.sn-btn');
+    var desktop = window.matchMedia('(min-width: 1081px)');
+
+    function closeAll(except) {
+      buttons.forEach(function (b) { if (b !== except) b.setAttribute('aria-expanded', 'false'); });
+    }
+
+    buttons.forEach(function (btn) {
+      var li = btn.parentElement;
+      var timer, hoverOpenedAt = 0;
+      btn.addEventListener('click', function (e) {
+        e.stopPropagation();
+        var open = btn.getAttribute('aria-expanded') === 'true';
+        // A mouse click right after hover opened the menu should keep it open, not close it.
+        if (open && Date.now() - hoverOpenedAt < 600) return;
+        closeAll(btn);
+        btn.setAttribute('aria-expanded', String(!open));
+        closeSearch();
+      });
+      // Hover opens on desktop; leaving closes after a short delay so diagonal mouse moves don't snap it shut.
+      li.addEventListener('mouseenter', function () {
+        if (!desktop.matches) return;
+        clearTimeout(timer); closeAll(btn);
+        if (btn.getAttribute('aria-expanded') !== 'true') { hoverOpenedAt = Date.now(); btn.setAttribute('aria-expanded', 'true'); }
+      });
+      li.addEventListener('mouseleave', function () {
+        if (!desktop.matches) return;
+        timer = setTimeout(function () { btn.setAttribute('aria-expanded', 'false'); }, 180);
+      });
+    });
+
+    // Mobile menu
+    var burger = header.querySelector('.sn-burger');
+    burger.addEventListener('click', function () {
+      var open = !header.classList.contains('is-open');
+      header.classList.toggle('is-open', open);
+      burger.setAttribute('aria-expanded', String(open));
+      burger.lastChild.nodeValue = open ? 'Close' : 'Menu';
+      document.documentElement.style.overflow = open ? 'hidden' : '';
+      if (!open) closeAll();
+    });
+    desktop.addEventListener && desktop.addEventListener('change', function () {
+      header.classList.remove('is-open'); burger.setAttribute('aria-expanded', 'false');
+      document.documentElement.style.overflow = ''; closeAll();
+    });
+
+    document.addEventListener('click', function (e) {
+      if (!header.contains(e.target)) { closeAll(); closeSearch(); }
+    });
+    document.addEventListener('keydown', function (e) {
+      if (e.key === 'Escape') {
+        var openBtn = header.querySelector('.sn-btn[aria-expanded="true"]');
+        closeAll(); closeSearch();
+        if (header.classList.contains('is-open')) burger.click();
+        if (openBtn) openBtn.focus();
+      }
+      if (e.key === '/' && !/^(INPUT|TEXTAREA|SELECT)$/.test((document.activeElement || {}).tagName || '') && !(document.activeElement || {}).isContentEditable) {
+        e.preventDefault(); openSearch();
+      }
+    });
+
+    // Search
+    var searchBtn = header.querySelector('.sn-search-btn');
+    var panel = header.querySelector('.sn-search');
+    var input = panel.querySelector('input');
+    var results = panel.querySelector('.sn-results');
+    var index = QUICK.map(function (q) { return { title: q[0], url: q[1], desc: q[2], kw: (q[0] + ' ' + q[2] + ' ' + q[3]).toLowerCase() }; });
+    var loaded = false;
+    var active = -1;
+
+    function loadIndex() {
+      if (loaded) return; loaded = true;
+      fetch('/search-index.json').then(function (r) { return r.ok ? r.json() : null; }).then(function (d) {
+        var pages = d && Array.isArray(d.pages) ? d.pages : (Array.isArray(d) ? d : []);
+        pages.forEach(function (p) {
+          var title = p.title || p.h1; if (!title || !p.url) return;
+          var kw = [title, p.h1, p.description, p.topic, Array.isArray(p.keywords) ? p.keywords.join(' ') : p.keyword].join(' ').toLowerCase();
+          index.push({ title: title, url: p.url, desc: p.topic || p.description || '', kw: kw });
+        });
+        if (input.value) render();
+      }).catch(function () { /* quick links still work */ });
+    }
+    function openSearch() {
+      closeAll();
+      if (header.classList.contains('is-open')) burger.click();
+      panel.hidden = false; searchBtn.setAttribute('aria-expanded', 'true');
+      loadIndex(); input.focus();
+    }
+    function closeSearch() {
+      if (panel.hidden) return;
+      panel.hidden = true; searchBtn.setAttribute('aria-expanded', 'false');
+      input.value = ''; results.textContent = ''; active = -1;
+    }
+    function render() {
+      var q = input.value.trim().toLowerCase();
+      results.textContent = ''; active = -1;
+      if (!q) return;
+      var words = q.split(/\s+/);
+      var seen = {};
+      var hits = index.filter(function (it) {
+        if (seen[it.url]) return false;
+        var ok = words.every(function (w) { return it.kw.indexOf(w) !== -1; });
+        if (ok) seen[it.url] = true;
+        return ok;
+      }).slice(0, 8);
+      if (!hits.length) {
+        var li = document.createElement('li'); li.className = 'sn-empty';
