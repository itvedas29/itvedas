# ITVedas Services — environment variables.
#
# NONE of these are read from a .env file at runtime. Cloudflare Pages
# Functions read them from the environment, which you set either in the
# Pages dashboard (Settings > Environment variables) or with
# `wrangler pages secret put <NAME>`.
#
# For LOCAL development, copy the non-secret ones into `services/.dev.vars`
# (gitignored) using the same KEY=value format. Never commit real secrets.

# --- email (optional; without it, notifications are skipped and logged) ----

# Resend API key. https://resend.com — used to send the customer confirmation
# and the admin notification. Set as a SECRET, not a plain variable.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The verified sender address emails come from, e.g. "ITVedas Services
# <services@itvedas.com>". Must be a domain verified in your email provider.
EMAIL_FROM=ITVedas Services <services@itvedas.com>

# Where new-enquiry notifications are sent. If unset, only the customer
# confirmation is sent.
ADMIN_NOTIFY_EMAIL=info@itvedas.com

# --- admin bootstrap (temporary) ------------------------------------------

# A long random string used ONCE to create the first admin account via
# POST /api/admin/bootstrap. The endpoint refuses to run when an admin
# already exists, but you should still DELETE this variable immediately
# after creating the account.
# Generate with: openssl rand -hex 32
ADMIN_BOOTSTRAP_TOKEN=

# --- bindings (NOT env vars — configured as bindings) ---------------------
# These are set in services/wrangler.toml or the Pages dashboard, not here:
#
#   DB          D1 database    (required — enquiries are stored here)
#   RATE_LIMIT  KV namespace   (recommended — without it rate limiting is
#                               skipped, i.e. the form is unthrottled)
#   ATTACHMENTS R2 bucket      (optional — without it, uploaded files are
#                               dropped, though the enquiry itself is saved)
